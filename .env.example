# ========================
# BACKEND ENVIRONMENT VARIABLES
# ========================

# Database (Local Development with Docker)
DATABASE_URL="postgresql://swapbuds_dev:swapbuds_dev_password@localhost:5432/swapbuds_dev"

# For Vercel Postgres (Production)
# DATABASE_URL="postgres://default:xxxx@xxxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# POSTGRES_PRISMA_URL="postgres://default:xxxx@xxxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
# POSTGRES_URL_NON_POOLING="postgres://default:xxxx@xxxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# JWT Authentication
JWT_SECRET="your_super_secret_jwt_key_change_in_production_min_32_chars"
JWT_EXPIRATION="24h"

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Redis (Session Management - Optional for local dev)
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# ========================
# FRONTEND ENVIRONMENT VARIABLES
# ========================

# API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Cloudinary (for direct uploads from frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# WebSocket URL
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# ========================
# NOTES
# ========================

# 1. Copy this file to:
#    - swapbuds-backend/.env
#    - swapbuds-frontend/.env.local
#
# 2. Update the values with your actual credentials
#
# 3. Get Cloudinary credentials from:
#    https://cloudinary.com/console
#
# 4. For production, use Vercel environment variables:
#    https://vercel.com/docs/concepts/projects/environment-variables
#
# 5. NEVER commit .env files to git!
